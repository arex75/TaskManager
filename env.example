# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/taskmanager
# For SQLite (development): DATABASE_URL=sqlite:///db.sqlite3

# OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret

# Frontend Configuration
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_LOGIN_SUCCESS_URL=http://localhost:3000/login
FRONTEND_COMPLETE_PROFILE_URL=http://localhost:3000/complete-profile

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@taskmanager.com

# Media and Static Files
MEDIA_URL=/media/
MEDIA_ROOT=media/

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/django.log
